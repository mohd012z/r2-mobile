<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: console on top, with FULL inside its corner. Tabs, command row and four menus at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="10dp"
            android:scrollbarStyle="insideOverlay">

            <!-- Long lines are not wrapped: swipe sideways to read them. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:fadeScrollbars="false"
                android:scrollbarAlwaysDrawHorizontalTrack="true"
                android:scrollbarSize="10dp"
                android:scrollbarStyle="insideOverlay">

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#C9D1D9"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- FULL / DEFAULT: hides the controls so the console fills the screen. Press again to get the controls back. -->
        <Button
            android:id="@+id/fullscreenButton"
            style="@style/CompactButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="FULL" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textSize="12sp" />

        <!-- Console tabs: small buttons, the same size as +. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabMenuButton"
                style="@style/CompactButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Tab 1 ▼" />

            <Button
                android:id="@+id/addTabButton"
                style="@style/CompactButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="+" />
        </LinearLayout>

        <!-- Command row: Functions on the left, the typed command, then the single Run button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/functionsPickButton"
                style="@style/CompactButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Functions ▼" />

            <EditText
                android:id="@+id/cmdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:hint="number, 0x address, or find WORD"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/runButton"
                style="@style/CompactButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Run" />
        </LinearLayout>

        <!-- Four menus, grouped by task. Each opens a dropdown list. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fileMenuButton"
                style="@style/CompactButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FILE ▼" />

            <Button
                android:id="@+id/runMenuButton"
                style="@style/CompactButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANALYZE ▼" />

            <Button
                android:id="@+id/findMenuButton"
                style="@style/CompactButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FIND ▼" />

            <Button
                android:id="@+id/viewMenuButton"
                style="@style/CompactButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIEW ▼" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
