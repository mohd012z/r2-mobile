<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: console on top (FULL inside its corner). Bottom dock, in order:
     progress, status, category strip (applies to every screen, scrolls if narrow),
     command row, then the menus grouped by category (FILES / ANALYZE / FIND / TOOLS / VIEW). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarSize="10dp"
            android:scrollbarStyle="insideOverlay">

            <!-- Long lines are not wrapped: swipe sideways to read them. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:fadeScrollbars="false"
                android:scrollbarAlwaysDrawHorizontalTrack="true"
                android:scrollbarSize="10dp"
                android:scrollbarStyle="insideOverlay">

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#C9D1D9"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </HorizontalScrollView>
        </ScrollView>

        <!-- FULL / DEFAULT: hides the dock so the console fills the screen. Press again to get it back. -->
        <Button
            android:id="@+id/fullscreenButton"
            style="@style/DockButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="FULL" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textSize="12sp" />

        <!-- Category strip: quick-pick the file type the functions are filtered by.
             It applies to the console (FUNCTIONS menu) and to the file manager (APK / DEX / SO). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:paddingTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Command row: tabs, then the typed command, then Run. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/tabMenuButton"
                style="@style/DockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="Tab 1 ▼" />

            <Button
                android:id="@+id/addTabButton"
                style="@style/DockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="+" />

            <EditText
                android:id="@+id/cmdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:hint="number, 0x address, or find WORD"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/runButton"
                style="@style/DockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="RUN" />
        </LinearLayout>

        <!-- Menus, grouped by category. Each opens a dropdown list. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/functionsPickButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FUNCTIONS ▼" />

            <Button
                android:id="@+id/fileMenuButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FILES ▼" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/runMenuButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANALYZE ▼" />

            <Button
                android:id="@+id/findMenuButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FIND ▼" />

            <Button
                android:id="@+id/pluginMenuButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOOLS ▼" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/viewMenuButton"
                style="@style/DockButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VIEW ▼" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
