<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One style for every dock button: compact, so the whole dock fits any screen height. -->
    <style name="DockButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <!-- Category chips in the quick-pick strip (ALL / APK / DEX / SO / ...). -->
    <style name="Chip" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
</resources>
